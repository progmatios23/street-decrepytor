{
	"schemaVersion": 1,
	"id": "sydney",
	"version": "26.0",
	"name": "Sydney",
	"description": "A utility mod aimed at anarchy servers, excelling in combat and visual features.",
	"authors": [
		"Aidan",
		"zoom"
	],
	"contact": {
		"homepage": "https://www.sydneyclient.net/"
	},
	"icon": "assets/sydney/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"net.sydneyclient.loader.entrypoints.FabricEntryPoint"
		],
		"preLaunch": [
			"net.sydneyclient.loader.entrypoints.FabricEntryPoint"
		]
	},
	"mixins": [
		"sydney.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": "*",
		"fabric-api": "*",
		"java": "*"
	}
}